{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/generate-seo-html.ts",
    "build:pages": "vite build && bun scripts/generate-seo-html.ts pages",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "new": "bun scripts/new-post.ts",
    "plugin:build": "bun build obsidian-plugin/src/main.ts --format=cjs --outfile=obsidian-plugin/main.js --external=obsidian --target=node --minify",
    "plugin:typecheck": "tsc -p obsidian-plugin/tsconfig.json --noEmit",
    "plugin:install": "bun scripts/install-plugin.ts"
  },
  "dependencies": {
    "@octanejs/stylex": "^0.1.64",
    "@octanejs/vite-plugin": "^0.4.0",
    "@tanstack/markdown": "^1.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "octane": "^0.13.1"
  },
  "devDependencies": {
    "@tsrx/oxc": "0.20.0",
    "@types/node": "^26.6.5",
    "obsidian": "^1.14.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.150.0"
  },
  "packageManager": "bun@1.3.14"
}
