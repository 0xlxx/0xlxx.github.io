{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bjorn-blog",
  "compatibility_date": "2026-05-11",
  // 纯静态站点：把 vite build 的产物直接当作 Workers Static Assets 发布。
  // 路由是客户端 pushState，未命中的路径交回 index.html（SPA 回退）。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
